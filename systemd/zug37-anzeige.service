# Zug 37: render the current edition and publish feed.json and the frame. No network, no model.
[Unit]
Description=Zug 37 Anzeige (render and publish)

[Service]
Type=oneshot
User=zug37
Group=zug37
StateDirectory=zug37
StateDirectoryMode=0700
UMask=0027
ReadWritePaths=/var/www/zug37
# read the published Signal Radar frame (0640, group www-data) to take turns with it; no network
SupplementaryGroups=www-data
ReadOnlyPaths=-/var/www/tickrmeter-signal-radar
EnvironmentFile=/etc/zug37.env
UnsetEnvironment=CLAUDE_CODE_OAUTH_TOKEN Z37_TG_TOKEN
WorkingDirectory=/opt/zug37
ExecStart=/usr/bin/python3 -s -B -m zug37.anzeige
TimeoutStartSec=60
MemoryMax=256M
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
TemporaryFileSystem=/opt:ro
BindReadOnlyPaths=/opt/zug37
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
